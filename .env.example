# Configure no painel ou use uma destas variáveis de ambiente.
XAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# Canal WhatsApp. Use cloud_api para a API oficial da Meta; deixe vazio para QR/Baileys.
WHATSAPP_CHANNEL=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_DISPLAY_PHONE_NUMBER=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_API_VERSION=v26.0
WHATSAPP_TENANT_ID=1

# Integração segura entre Vercel, backend Chat Ativa e n8n.
CHAT_ATIVA_INTEGRATION_KEY=
CHAT_ATIVA_BACKEND_URL=
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
N8N_TIMEOUT_MS=8000

# Password to access the web dashboard. If empty, the dashboard is open (dev mode only!)
DASHBOARD_PASSWORD=

# Port for the web dashboard
PORT=3000
